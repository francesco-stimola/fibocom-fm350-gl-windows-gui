<!-- The main window. A key in double square brackets is a text of the app's language
     (Strings\<language>.psd1), put in place before the XAML is read (ConvertTo-LocalizedXaml). -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fibocom FM350-GL Windows GUI" Width="700" Height="620" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterScreen" FontSize="13">
    <DockPanel Margin="12">
        <!-- The connection, always in view. -->
        <Border DockPanel.Dock="Top" Padding="10" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="ToneDot" Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center" Fill="#8A8A8A"/>
                    <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TechnologyText" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#505050"/>
                    <TextBlock x:Name="OperatorText" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#505050"/>
                </StackPanel>
                <TextBlock x:Name="DetailText" TextWrapping="Wrap" Margin="20,4,0,0"/>
                <!-- The SIM in use, always in view: the slot is persistent modem state (decided 2026-10-04). -->
                <TextBlock x:Name="SimInUseText" TextWrapping="Wrap" Margin="20,4,0,0" Foreground="#505050" Visibility="Collapsed"/>
                <TextBlock x:Name="NoteText" TextWrapping="Wrap" Margin="20,4,0,0" Foreground="#606060"/>
            </StackPanel>
        </Border>

        <!-- What blocks the connection, with the action that unblocks it. -->
        <Border x:Name="BlockerPanel" DockPanel.Dock="Top" Margin="0,8,0,0" Padding="10" Background="#FFF6F6" BorderBrush="#E3B5B5" BorderThickness="1" CornerRadius="4" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="BlockerText" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBox x:Name="BlockerInput" Width="240" Margin="0,0,8,0" Visibility="Collapsed"/>
                    <PasswordBox x:Name="BlockerSecret" Width="240" Margin="0,0,8,0" Visibility="Collapsed"/>
                    <Button x:Name="BlockerButton" Padding="12,3" Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- The last command's outcome, the port, the time of the last update: wrapped beside the
             button, never under it. -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button x:Name="CheckNowButton" DockPanel.Dock="Right" Content="[[Xaml.CheckNow]]" Padding="12,3" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
            <StackPanel>
                <TextBlock x:Name="ResultText" TextWrapping="Wrap"/>
                <TextBlock x:Name="FooterText" TextWrapping="Wrap" Foreground="#707070" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <TabControl x:Name="Tabs" Margin="0,8,0,0">
            <TabItem Header="[[Xaml.SignalTab]]">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="SignalText" TextWrapping="Wrap"/>
                        <TextBlock Text="[[Xaml.Cells]]" FontWeight="SemiBold" Margin="0,10,0,4"/>
                    </StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="CellsGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" GridLinesVisibility="None">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="[[Xaml.Cell]]" Binding="{Binding Role}"/>
                                <DataGridTextColumn Header="RAT" Binding="{Binding Rat}"/>
                                <DataGridTextColumn Header="[[Xaml.Band]]" Binding="{Binding Band}"/>
                                <DataGridTextColumn Header="[[Xaml.Channel]]" Binding="{Binding Channel}"/>
                                <DataGridTextColumn Header="PCI" Binding="{Binding Pci}"/>
                                <DataGridTextColumn Header="[[Xaml.Bandwidth]]" Binding="{Binding Bandwidth}"/>
                                <DataGridTextColumn Header="RSRP" Binding="{Binding Rsrp}"/>
                                <DataGridTextColumn Header="RSRQ" Binding="{Binding Rsrq}"/>
                                <DataGridTextColumn Header="SINR" Binding="{Binding Sinr}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="1" Text="[[Xaml.CarrierAggregation]]" FontWeight="SemiBold" Margin="0,10,0,4"/>
                        <DataGrid x:Name="CarriersGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" GridLinesVisibility="None">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="[[Xaml.Carrier]]" Binding="{Binding Carrier}"/>
                                <DataGridTextColumn Header="[[Xaml.State]]" Binding="{Binding State}"/>
                                <DataGridTextColumn Header="[[Xaml.Band]]" Binding="{Binding Band}"/>
                                <DataGridTextColumn Header="[[Xaml.Channel]]" Binding="{Binding Channel}"/>
                                <DataGridTextColumn Header="PCI" Binding="{Binding Pci}"/>
                                <DataGridTextColumn Header="[[Xaml.BandwidthDlUl]]" Binding="{Binding Bandwidth}"/>
                                <DataGridTextColumn Header="MIMO DL/UL" Binding="{Binding Mimo}"/>
                                <DataGridTextColumn Header="[[Xaml.ModulationDlUl]]" Binding="{Binding Modulation}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- The messages on the SIM, newest first, the selected one below the list, and a box
                 to write one at the bottom (decided 2026-10-04). -->
            <TabItem x:Name="MessagesTab" Header="[[Xaml.MessagesTab]]">
                <DockPanel Margin="10">
                    <TextBlock x:Name="MessagesStateText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="8" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="[[Xaml.NewMessage]]" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="[[Xaml.To]]" MinWidth="40" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="MessageToBox" Width="200" MaxLength="30"/>
                            </StackPanel>
                            <TextBox x:Name="MessageTextBox" Margin="0,6,0,0" Height="48" MaxLength="39015" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            <DockPanel Margin="0,6,0,0">
                                <Button x:Name="SendMessageButton" DockPanel.Dock="Right" Content="[[Xaml.Send]]" Padding="16,3" Margin="8,0,0,0"/>
                                <TextBlock x:Name="MessageCountText" VerticalAlignment="Center" Foreground="#606060" TextWrapping="Wrap"/>
                            </DockPanel>
                            <TextBlock x:Name="MessageFromText" Margin="0,4,0,0" Foreground="#606060" TextWrapping="Wrap"/>
                            <TextBlock Text="[[Xaml.SendNote]]" Margin="0,4,0,0" Foreground="#606060" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*" MinHeight="90"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="MessagesGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" GridLinesVisibility="None" SelectionMode="Single">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding New}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="" Binding="{Binding Marker}" Width="22"/>
                                <DataGridTextColumn Header="[[Xaml.From]]" Binding="{Binding From}" MinWidth="110"/>
                                <DataGridTextColumn Header="[[Xaml.Time]]" Binding="{Binding Time}" MinWidth="115"/>
                                <DataGridTextColumn Header="[[Xaml.Message]]" Binding="{Binding Preview}" Width="*" MinWidth="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Grid.Row="1" Margin="0,8,0,4">
                            <Button x:Name="DeleteMessageButton" DockPanel.Dock="Right" Content="[[Xaml.DeleteMessage]]" Padding="10,2" Margin="8,0,0,0"/>
                            <TextBlock x:Name="MessageHeaderText" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBox x:Name="MessageBodyText" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"/>
                                <TextBlock x:Name="MessageNoteText" Foreground="#606060" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Data usage: today, the cycle, the quota, and their two settings. -->
            <TabItem x:Name="DataTab" Header="[[Xaml.DataTab]]">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock x:Name="UsageTodayText" TextWrapping="Wrap"/>
                        <TextBlock x:Name="UsageCycleText" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock x:Name="UsageQuotaText" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <ProgressBar x:Name="UsageQuotaBar" Height="12" Maximum="100" Margin="0,4,0,0" Visibility="Collapsed"/>
                        <TextBlock Text="[[Xaml.UsageNote]]" TextWrapping="Wrap" Foreground="#606060" Margin="0,10,0,0"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="[[Xaml.CycleDay]]" Margin="0,4,12,4" VerticalAlignment="Center"/>
                            <TextBox x:Name="CycleDayBox" Grid.Row="0" Grid.Column="1" Width="60" Margin="0,4" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="1" Text="[[Xaml.Quota]]" Margin="0,4,12,4" VerticalAlignment="Center"/>
                            <TextBox x:Name="QuotaBox" Grid.Row="1" Grid.Column="1" Width="80" Margin="0,4" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="[[Xaml.QuotaNote]]" Foreground="#606060" TextWrapping="Wrap"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="SaveUsageButton" Content="[[Xaml.Save]]" Padding="16,3"/>
                            <Button x:Name="ReloadUsageButton" Content="[[Xaml.Undo]]" Margin="8,0,0,0" Padding="10,3"/>
                        </StackPanel>
                        <TextBlock x:Name="UsageProblemText" TextWrapping="Wrap" Foreground="#B03030" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="SimTab" Header="SIM">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <!-- The physical SIM's button; the eSIM tab has the eSIM's: one SIM at a time. -->
                        <DockPanel Margin="0,0,0,10">
                            <Button x:Name="UsePhysicalButton" DockPanel.Dock="Right" Padding="10,2" Margin="8,0,0,0" VerticalAlignment="Top"/>
                            <TextBlock x:Name="SimSlotNoteText" TextWrapping="Wrap" Foreground="#606060"/>
                        </DockPanel>
                        <TextBlock x:Name="SimStateText" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SimRequestText" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SimStoredText" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SimNoteText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#B03030" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="PIN" VerticalAlignment="Center" Width="40"/>
                            <PasswordBox x:Name="SimPinBox" Width="120" MaxLength="8"/>
                            <Button x:Name="StorePinButton" Content="[[Xaml.StorePin]]" Margin="8,0,0,0" Padding="10,2"/>
                        </StackPanel>
                        <WrapPanel Margin="40,8,0,0">
                            <Button x:Name="ForgetPinButton" Content="[[Xaml.ForgetPin]]" Margin="0,0,8,4" Padding="10,2"/>
                            <Button x:Name="DisablePinButton" Content="[[Xaml.DisablePin]]" Margin="0,0,0,4" Padding="10,2"/>
                        </WrapPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="#606060" Margin="0,10,0,0" Text="[[Xaml.PinNote]]"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- The eSIM (decided 2026-10-04): the slot in use and the eSIM's button, the EID with Copy,
                 the profiles and what can be done with each, a download from an activation code
                 typed or read from the image of its QR code. -->
            <TabItem x:Name="EsimTab" Header="[[Xaml.EsimTab]]">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <DockPanel>
                            <Button x:Name="UseEsimButton" DockPanel.Dock="Right" Padding="10,2" Margin="8,0,0,0" VerticalAlignment="Top"/>
                            <StackPanel>
                                <TextBlock x:Name="EsimSlotText" TextWrapping="Wrap"/>
                                <TextBlock x:Name="EsimSlotNoteText" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#606060"/>
                                <TextBlock x:Name="EsimStateText" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#606060"/>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel x:Name="EidPanel" Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="EID" VerticalAlignment="Center" Width="40"/>
                            <TextBox x:Name="EidBox" IsReadOnly="True" Width="300" FontFamily="Consolas"/>
                            <Button x:Name="CopyEidButton" Content="[[Xaml.EsimCopy]]" Margin="8,0,0,0" Padding="10,2"/>
                        </StackPanel>
                        <TextBlock x:Name="EsimChipText" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#606060"/>
                        <TextBlock x:Name="EsimNotificationText" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="#606060"/>
                        <DockPanel Margin="0,10,0,4">
                            <Button x:Name="ReadEsimButton" DockPanel.Dock="Right" Content="[[Xaml.EsimReadAgain]]" Padding="10,2"/>
                            <TextBlock Text="[[Xaml.EsimProfiles]]" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DataGrid x:Name="ProfilesGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" GridLinesVisibility="None" SelectionMode="Single" MinHeight="70">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Enabled}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="[[Xaml.EsimName]]" Binding="{Binding Name}" Width="*" MinWidth="120"/>
                                <DataGridTextColumn Header="[[Xaml.EsimProvider]]" Binding="{Binding Provider}" MinWidth="100"/>
                                <DataGridTextColumn Header="[[Xaml.EsimKind]]" Binding="{Binding Kind}" MinWidth="70"/>
                                <DataGridTextColumn Header="[[Xaml.State]]" Binding="{Binding State}" MinWidth="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="EnableProfileButton" Content="[[Xaml.EsimEnable]]" Margin="0,0,8,4" Padding="12,2"/>
                            <Button x:Name="DisableProfileButton" Content="[[Xaml.EsimDisable]]" Margin="0,0,8,4" Padding="12,2"/>
                            <Button x:Name="DeleteProfileButton" Content="[[Xaml.EsimDelete]]" Margin="0,0,0,4" Padding="10,2"/>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="[[Xaml.EsimNickname]]" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="NicknameBox" Width="200" MaxLength="64"/>
                            <Button x:Name="RenameProfileButton" Content="[[Xaml.EsimRename]]" Margin="8,0,0,0" Padding="10,2"/>
                        </StackPanel>
                        <Border Margin="0,12,0,0" Padding="8" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="[[Xaml.EsimDownload]]" FontWeight="SemiBold"/>
                                <TextBlock Text="[[Xaml.EsimCode]]" Margin="0,6,0,2"/>
                                <StackPanel Orientation="Horizontal">
                                    <PasswordBox x:Name="ActivationCodeBox" Width="300"/>
                                    <Button x:Name="ReadQrButton" Content="[[Xaml.EsimReadQr]]" Margin="8,0,0,0" Padding="10,2" ToolTipService.ShowOnDisabled="True"/>
                                </StackPanel>
                                <TextBlock x:Name="QrImageText" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#606060" Visibility="Collapsed"/>
                                <TextBlock Text="[[Xaml.EsimConfirmation]]" Margin="0,8,0,2"/>
                                <PasswordBox x:Name="ConfirmationCodeBox" Width="160" HorizontalAlignment="Left"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="DownloadProfileButton" Content="[[Xaml.EsimDownloadButton]]" Padding="16,3"/>
                                </StackPanel>
                                <TextBlock x:Name="EsimHintText" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#B03030" Visibility="Collapsed"/>
                                <TextBlock Text="[[Xaml.EsimDownloadNote]]" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#606060"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="[[Xaml.NetworkTab]]">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="CurrentModeText" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="[[Xaml.NetworkMode]]" MinWidth="110" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="NetworkModeBox" Width="200" DisplayMemberPath="Text"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock x:Name="ModeNoteText" TextWrapping="Wrap" Foreground="#606060" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="ApplyModeButton" Content="[[Xaml.Apply]]" Padding="16,3"/>
                            <Button x:Name="ReloadModeButton" Content="[[Xaml.Undo]]" Margin="8,0,0,0" Padding="10,3"/>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="#606060" Margin="0,8,0,0" Text="[[Xaml.ModeNote]]"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel x:Name="BandsPanel">
                            <CheckBox x:Name="LteAllBox" Content="[[Xaml.LteAll]]" FontWeight="SemiBold"/>
                            <WrapPanel x:Name="LteBandsPanel" Margin="20,4,0,8"/>
                            <CheckBox x:Name="NrAllBox" Content="[[Xaml.NrAll]]" FontWeight="SemiBold"/>
                            <WrapPanel x:Name="NrBandsPanel" Margin="20,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="ConnectionTab" Header="[[Xaml.ConnectionTab]]">
                <!-- Scrolls when the window is too small for it. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <!-- Whose APN settings these are: each SIM keeps its own. -->
                        <TextBlock x:Name="ApnSimText" TextWrapping="Wrap" Foreground="#606060" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="APN" Margin="0,4,12,4" VerticalAlignment="Center"/>
                            <TextBox x:Name="ApnBox" Grid.Row="0" Grid.Column="1" Margin="0,4" ToolTip="[[Xaml.ApnTip]]"/>
                            <TextBlock Grid.Row="1" Text="[[Xaml.PdpType]]" Margin="0,4,12,4" VerticalAlignment="Center"/>
                            <ComboBox x:Name="PdpTypeBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Width="140" HorizontalAlignment="Left">
                                <ComboBoxItem Content="IPV4V6" Tag="IPV4V6"/>
                                <ComboBoxItem Content="IP" Tag="IP"/>
                            </ComboBox>
                            <TextBlock Grid.Row="2" Text="[[Xaml.Authentication]]" Margin="0,4,12,4" VerticalAlignment="Center"/>
                            <ComboBox x:Name="AuthenticationBox" Grid.Row="2" Grid.Column="1" Margin="0,4" Width="140" HorizontalAlignment="Left">
                                <ComboBoxItem Content="[[Xaml.AuthNone]]" Tag="None"/>
                                <ComboBoxItem Content="PAP" Tag="PAP"/>
                                <ComboBoxItem Content="CHAP" Tag="CHAP"/>
                            </ComboBox>
                            <TextBlock Grid.Row="3" Text="[[Xaml.User]]" Margin="0,4,12,4" VerticalAlignment="Center"/>
                            <TextBox x:Name="ApnUserBox" Grid.Row="3" Grid.Column="1" Margin="0,4"/>
                            <TextBlock Grid.Row="4" Text="[[Xaml.Password]]" Margin="0,4,12,4" VerticalAlignment="Center"/>
                            <WrapPanel Grid.Row="4" Grid.Column="1" Margin="0,4">
                                <PasswordBox x:Name="ApnPasswordBox" Width="200" Margin="0,0,10,0"/>
                                <CheckBox x:Name="ClearPasswordBox" Content="[[Xaml.ClearPassword]]" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <TextBlock x:Name="ApnPasswordStoredText" Grid.Row="5" Grid.Column="1" Margin="0,0,0,4" Foreground="#606060"/>
                            <TextBlock Grid.Row="6" Text="[[Xaml.DnsServers]]" Margin="0,4,12,4" VerticalAlignment="Center"/>
                            <TextBox x:Name="DnsBox" Grid.Row="6" Grid.Column="1" Margin="0,4" ToolTip="[[Xaml.DnsTip]]"/>
                            <TextBlock Grid.Row="7" Text="[[Xaml.EncryptedDns]]" Margin="0,4,12,4" VerticalAlignment="Center"/>
                            <CheckBox x:Name="DohBox" Grid.Row="7" Grid.Column="1" Margin="0,4" VerticalAlignment="Center">
                                <TextBlock Text="[[Xaml.Doh]]" TextWrapping="Wrap"/>
                            </CheckBox>
                            <TextBlock Grid.Row="8" Text="[[Xaml.DohTemplate]]" Margin="0,4,12,4" VerticalAlignment="Center"/>
                            <TextBox x:Name="DohTemplateBox" Grid.Row="8" Grid.Column="1" Margin="0,4" ToolTip="[[Xaml.DohTemplateTip]]"/>
                            <WrapPanel Grid.Row="9" Grid.Column="1" Margin="0,4">
                                <TextBlock Text="[[Xaml.RefreshBefore]]" VerticalAlignment="Center"/>
                                <TextBox x:Name="DohRefreshBox" Width="60" Margin="6,0"/>
                                <TextBlock Text="[[Xaml.RefreshAfter]]" VerticalAlignment="Center" Foreground="#606060" TextWrapping="Wrap"/>
                            </WrapPanel>
                            <TextBlock x:Name="DohStateText" Grid.Row="10" Grid.Column="1" Margin="0,0,0,4" Foreground="#606060" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="11" Text="[[Xaml.Metric]]" Margin="0,4,12,4" VerticalAlignment="Center"/>
                            <DockPanel Grid.Row="11" Grid.Column="1" Margin="0,4">
                                <TextBox x:Name="MetricBox" Width="80" VerticalAlignment="Center"/>
                                <TextBlock Text="[[Xaml.MetricNote]]" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#606060" TextWrapping="Wrap"/>
                            </DockPanel>
                            <TextBlock Grid.Row="12" Text="[[Xaml.Updates]]" Margin="0,4,12,4" VerticalAlignment="Center"/>
                            <CheckBox x:Name="UpdateCheckBox" Grid.Row="12" Grid.Column="1" Margin="0,4" VerticalAlignment="Center">
                                <TextBlock Text="[[Xaml.UpdateCheck]]" TextWrapping="Wrap"/>
                            </CheckBox>
                            <TextBlock Grid.Row="13" Text="[[Xaml.Startup]]" Margin="0,4,12,4" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="13" Grid.Column="1" Margin="0,4">
                                <CheckBox x:Name="StartupBox" VerticalAlignment="Center">
                                    <TextBlock Text="[[Xaml.StartAtLogon]]" TextWrapping="Wrap"/>
                                </CheckBox>
                                <TextBlock x:Name="StartupNoteText" Foreground="#606060" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                            <StackPanel Grid.Row="14" Grid.ColumnSpan="2" Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="SaveSettingsButton" Content="[[Xaml.Save]]" Padding="16,3"/>
                                    <Button x:Name="ReloadSettingsButton" Content="[[Xaml.Undo]]" Margin="8,0,0,0" Padding="10,3"/>
                                </StackPanel>
                                <TextBlock x:Name="SettingsProblemText" TextWrapping="Wrap" Foreground="#B03030" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="UsbTab" Header="[[Xaml.UsbTab]]">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock x:Name="UsbStateText" TextWrapping="Wrap"/>
                        <TextBlock x:Name="UsbFunctionsText" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <TextBlock x:Name="UsbBindingText" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="UsbNoteText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#606060" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
