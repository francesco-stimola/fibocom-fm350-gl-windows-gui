        @{ Septet = 0x7A; CodePoint = 0x007A } # z
        @{ Septet = 0x7B; CodePoint = 0x00E4 } # ä
        @{ Septet = 0x7C; CodePoint = 0x00F6 } # ö
        @{ Septet = 0x7D; CodePoint = 0x00F1 } # ñ
        @{ Septet = 0x7E; CodePoint = 0x00FC } # ü
        @{ Septet = 0x7F; CodePoint = 0x00E0 } # à
    )
    Extension = @(
        @{ Septet = 0x0A; CodePoint = 0x000C } # page break
        @{ Septet = 0x14; CodePoint = 0x005E } # ^
        @{ Septet = 0x28; CodePoint = 0x007B } # {
        @{ Septet = 0x29; CodePoint = 0x007D } # }
        @{ Septet = 0x2F; CodePoint = 0x005C } # \
        @{ Septet = 0x3C; CodePoint = 0x005B } # [
        @{ Septet = 0x3D; CodePoint = 0x007E } # ~
        @{ Septet = 0x3E; CodePoint = 0x005D } # ]
        @{ Septet = 0x40; CodePoint = 0x007C } # |
        @{ Septet = 0x65; CodePoint = 0x20AC } # €
    )
}
