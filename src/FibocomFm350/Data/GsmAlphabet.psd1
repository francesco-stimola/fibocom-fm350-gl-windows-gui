        @{ Septet = 0x5E; CodePoint = 0x00DC } # Ü
        @{ Septet = 0x5F; CodePoint = 0x00A7 } # §
        @{ Septet = 0x60; CodePoint = 0x00BF } # ¿
        @{ Septet = 0x61; CodePoint = 0x0061 } # a
        @{ Septet = 0x62; CodePoint = 0x0062 } # b
        @{ Septet = 0x63; CodePoint = 0x0063 } # c
        @{ Septet = 0x64; CodePoint = 0x0064 } # d
