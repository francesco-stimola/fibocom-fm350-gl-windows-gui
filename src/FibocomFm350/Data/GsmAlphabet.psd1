        @{ Septet = 0x3D; CodePoint = 0x003D } # =
        @{ Septet = 0x3E; CodePoint = 0x003E } # >
        @{ Septet = 0x3F; CodePoint = 0x003F } # ?
        @{ Septet = 0x40; CodePoint = 0x00A1 } # ¡
        @{ Septet = 0x41; CodePoint = 0x0041 } # A
        @{ Septet = 0x42; CodePoint = 0x0042 } # B
