# The GSM 7 bit default alphabet and its extension table: 3GPP TS 23.038 V19.0.0 (ETSI TS 123 038
# V19.0.0), clauses 6.2.1 and 6.2.1.1. Each entry is a septet and the Unicode code point it stands
# for. Septet 0x1B is the escape to the extension table (no character of its own); in the extension
# table 0x0A is the page break, shown as a form feed, and 0x1B the escape to a further table, which
# is not defined and shows as a space. A septet missing from the extension table reads as the
# default alphabet's character (clause 6.2.1.1).
@{
    Source    = '3GPP TS 23.038 V19.0.0, clauses 6.2.1 and 6.2.1.1'
    Default   = @(
        @{ Septet = 0x00; CodePoint = 0x0040 } # @
        @{ Septet = 0x01; CodePoint = 0x00A3 } # £
        @{ Septet = 0x02; CodePoint = 0x0024 } # $
        @{ Septet = 0x03; CodePoint = 0x00A5 } # ¥
        @{ Septet = 0x04; CodePoint = 0x00E8 } # è
        @{ Septet = 0x05; CodePoint = 0x00E9 } # é
        @{ Septet = 0x06; CodePoint = 0x00F9 } # ù
        @{ Septet = 0x07; CodePoint = 0x00EC } # ì
        @{ Septet = 0x08; CodePoint = 0x00F2 } # ò
        @{ Septet = 0x09; CodePoint = 0x00C7 } # Ç
        @{ Septet = 0x0A; CodePoint = 0x000A } # LF
        @{ Septet = 0x0B; CodePoint = 0x00D8 } # Ø
        @{ Septet = 0x0C; CodePoint = 0x00F8 } # ø
        @{ Septet = 0x0D; CodePoint = 0x000D } # CR
        @{ Septet = 0x0E; CodePoint = 0x00C5 } # Å
        @{ Septet = 0x0F; CodePoint = 0x00E5 } # å
        @{ Septet = 0x10; CodePoint = 0x0394 } # Δ
        @{ Septet = 0x11; CodePoint = 0x005F } # _
        @{ Septet = 0x12; CodePoint = 0x03A6 } # Φ
        @{ Septet = 0x13; CodePoint = 0x0393 } # Γ
        @{ Septet = 0x14; CodePoint = 0x039B } # Λ
        @{ Septet = 0x15; CodePoint = 0x03A9 } # Ω
        @{ Septet = 0x16; CodePoint = 0x03A0 } # Π
        @{ Septet = 0x17; CodePoint = 0x03A8 } # Ψ
        @{ Septet = 0x18; CodePoint = 0x03A3 } # Σ
        @{ Septet = 0x19; CodePoint = 0x0398 } # Θ
        @{ Septet = 0x1A; CodePoint = 0x039E } # Ξ
        @{ Septet = 0x1C; CodePoint = 0x00C6 } # Æ
        @{ Septet = 0x1D; CodePoint = 0x00E6 } # æ
        @{ Septet = 0x1E; CodePoint = 0x00DF } # ß
        @{ Septet = 0x1F; CodePoint = 0x00C9 } # É
        @{ Septet = 0x20; CodePoint = 0x0020 } # SP
        @{ Septet = 0x21; CodePoint = 0x0021 } # !
        @{ Septet = 0x22; CodePoint = 0x0022 } # "
        @{ Septet = 0x23; CodePoint = 0x0023 } # #
        @{ Septet = 0x24; CodePoint = 0x00A4 } # ¤
        @{ Septet = 0x25; CodePoint = 0x0025 } # %
        @{ Septet = 0x26; CodePoint = 0x0026 } # &
        @{ Septet = 0x27; CodePoint = 0x0027 } # '
        @{ Septet = 0x28; CodePoint = 0x0028 } # (
        @{ Septet = 0x29; CodePoint = 0x0029 } # )
